{
  "name": "@meetopenbot/claude-code",
  "version": "0.1.5",
  "type": "module",
  "description": "Claude Code plugin for OpenBot",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:melony --external:zod",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@meetopenbot/plugin-sdk": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.1",
    "esbuild": "^0.21.0",
    "zod": "^4.3.5"
  }
}